# Copy this file to .env.local and fill in the values as each phase needs them.
# NEVER put secrets in variables that start with NEXT_PUBLIC_ (those are sent to the browser).

# --- Phase 0 ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 3 (Supabase) ----------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server only

# --- Phase 4 (Gemini) ------------------------------------------------------
# GEMINI_API_KEY=                   # server only

# --- Phase 5-6 (Stripe, TEST MODE) -----------------------------------------
# STRIPE_SECRET_KEY=                # server only
# STRIPE_WEBHOOK_SECRET=            # server only

# --- Phase 7 ---------------------------------------------------------------
# DEMO_MODE=false
